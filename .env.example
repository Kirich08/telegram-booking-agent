# Copy this file to .env and fill in the values. Never commit .env to GitHub.

# --- Telegram (get them at https://my.telegram.org -> API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Phone of the Telegram user account the agent will act as, e.g. +380501234567
TELEGRAM_PHONE=

# --- Model provider: choose ONE provider ---
# Recommended when you cannot top up OpenAI: Google AI Studio Gemini Free tier.
# Create a key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=

# Or use OpenAI. If GEMINI_API_KEY is non-empty, Gemini takes precedence.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint (only used when Gemini is not selected).
OPENAI_BASE_URL=

# --- Who the agent messages ---
MANAGER_USERNAME=@vlad_dev_7
# Optional test recipient for --test. Leave empty if you do not have a separate test account.
TEST_MANAGER_USERNAME=

# --- Behaviour ---
FOLLOW_UP_MINUTES=15
MAX_FOLLOW_UPS=2
ENABLE_VOICE=false

# --- Files ---
LOG_FILE=logs/agent.log
SESSION_FILE=booking_agent.session
